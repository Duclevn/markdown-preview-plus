{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Preview Plus",
  "version": "1.0.1",
  "identifier": "com.markdownpreviewplus.reader",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Markdown Preview Plus",
        "width": 1040,
        "height": 780,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost"],
        "font-src": ["'self'", "data:"],
        "img-src": ["'self'", "data:"],
        "script-src": ["'self'", "'wasm-unsafe-eval'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "form-action": ["'none'"],
        "frame-src": ["'none'"]
      },
      "devCsp": {
        "default-src": ["'self'"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "http://127.0.0.1:1420",
          "ws://127.0.0.1:1420"
        ],
        "font-src": ["'self'", "data:"],
        "img-src": ["'self'", "data:"],
        "script-src": ["'self'", "'wasm-unsafe-eval'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "form-action": ["'none'"],
        "frame-src": ["'none'"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A read-only Markdown reader",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
